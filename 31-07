def needman_badman(seq1, seq2):
    

    m = len(seq1)
    n = len(seq2)

    # Initialize score matrix
    score_matrix = [[0 for _ in range(n+1)] for _ in range(m+1)]

    # Define scoring scheme
    gap_penalty = -2
    match_score = 1
    mismatch_penalty = -1

    # Initialize first column
    for i in range(1, m+1):
        score_matrix[i][0] = score_matrix[i-1][0] + gap_penalty

    # Initialize first row
    for j in range(1, n+1):
        score_matrix[0][j] = score_matrix[0][j-1] + gap_penalty

    # Fill the matrix
    for i in range(1, m+1):
        for j in range(1, n+1):
            if seq1[i-1] == seq2[j-1]:
                diagonal_score = score_matrix[i-1][j-1] + match_score
            else:
                diagonal_score = score_matrix[i-1][j-1] + mismatch_penalty

            up_score = score_matrix[i-1][j] + gap_penalty
            left_score = score_matrix[i][j-1] + gap_penalty

            score_matrix[i][j] = max(diagonal_score, up_score, left_score)
    
    while i > 0 and j > 0:
        current_score = score_matrix[i][j]

        if seq1[i - 1] == seq2[j - 1]:
            score = match_score
        else:
            score = mismatch_penalty

        if current_score == score_matrix[i - 1][j - 1] + score:
            seq1 = seq1[i - 1] + seq1
            seq2 = seq2[j - 1] + seq2
            i -= 1
            j -= 1

        elif current_score == score_matrix[i - 1][j] + gap_penalty:
            seq1 = seq1[i - 1] + seq1
            seq2 = "-" + seq2
            i -= 1

        else:
            seq1 = "-" + seq1
            seq2 = seq2[j - 1] + seq2
            j -= 1

    while i > 0:
        seq1 = seq1[i - 1] + seq1
        seq2 = "-" + seq2
        i -= 1

    while j > 0:
        seq1 = "-" + seq1
        seq2 = seq2[j - 1] + seq2
        j -= 1

    return seq1, seq2, score_matrix[m][n], score_matrix
    
    
print(needman_badman("GAT","GCT"))
